# Copy to .env.local. Never commit real values.
ANTHROPIC_API_KEY=
# Messaging (Phase 1): iMessage bridge provider + Twilio SMS fallback
IMESSAGE_BRIDGE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Ordering aggregator (pending diligence)
MEALME_API_KEY=
# Payments: hosted card capture only, tokens only
STRIPE_SECRET_KEY=
DATABASE_URL=
# Wally's phone number in E.164 form, e.g. +13105550142. Used for the first-text link.
NEXT_PUBLIC_WALLY_NUMBER=
# Text verification (Twilio Verify). Create a Verify service in the Twilio console.
TWILIO_VERIFY_SERVICE_SID=
# Signs the session cookie. At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
# Local testing only: accept this 6-digit code without sending a text. Ignored in Vercel production.
WALLY_DEV_VERIFY_CODE=
# Google sign-in. OAuth client (Web application) from Google Cloud console.
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email sign-in links, sent through Resend. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Optional. Public origin used in emailed links and OAuth redirects, e.g. https://wally-kohl.vercel.app
APP_URL=
# Local testing only: show the sign-in link on screen instead of emailing it. Ignored in Vercel production.
WALLY_DEV_EMAIL_LINKS=
