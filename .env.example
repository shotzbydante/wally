# Copy to .env.local. Never commit real values.
# Claude powers Ask Wally. Create a key at https://platform.claude.com/settings/keys
# Server only: never a NEXT_PUBLIC_ variable. Without it, Ask Wally says it isn't switched on.
ANTHROPIC_API_KEY=
# Optional. Which Claude model answers (default claude-sonnet-5-5).
WALLY_MODEL=
# Google Places API (New), for the saved address and for finding places near it.
# Enable "Places API (New)" in a Google Cloud project and create an API key restricted to it.
# Server only: never a NEXT_PUBLIC_ variable. Without it, Wally falls back to web search and the address bar is hidden.
GOOGLE_MAPS_API_KEY=
# Optional. Messages one account may send in 24 hours (default 100). Caps what one person can spend.
WALLY_DAILY_MESSAGES=
# Texting Wally. Either provider, or both. A reply leaves through the one the text came in by.
# Apply supabase/migrations/20261013000000_texting.sql first.
#
# iMessage (blue bubbles), through Sendblue. Keys and the line's number are in the Sendblue dashboard.
# Set its "receive" webhook to https://<your-domain>/api/text/sendblue?key=<SENDBLUE_WEBHOOK_SECRET>
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
# Wally's Sendblue number in E.164 form, e.g. +13105550142.
SENDBLUE_FROM_NUMBER=
# Any long random string you choose: openssl rand -hex 24
SENDBLUE_WEBHOOK_SECRET=
#
# Plain SMS, through Twilio. The SID and token are also used by Twilio Verify below.
# Set the number's incoming-message webhook to POST https://<your-domain>/api/text/twilio,
# and set APP_URL to that same origin (Twilio signs the exact address).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of these: a Messaging Service SID (MG...), or the Twilio number in E.164 form.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Ordering at restaurants that take orders through Square, via MealMe's self-serve API (mealmeai.vercel.app).
# Key from the MealMe console (starts mm_live_). Server only. Every successful call is billed (about $0.10).
# Without it, Wally offers no ordering.
MEALME_API_KEY=
# Payments: hosted card capture only, tokens only
STRIPE_SECRET_KEY=
# Accounts database (Supabase, used as Postgres from the server only).
# Run supabase/migrations/*.sql in the Supabase SQL editor first.
# URL: Project Settings > Data API. Key: Project Settings > API Keys > Secret key
# (sb_secret_...). Never the publishable key, and never a NEXT_PUBLIC_ variable.
# Without these two, the profile is kept in the session cookie, one browser at a time.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Wally's phone number in E.164 form, e.g. +13105550142. Used for the first-text link and his contact card.
# With both providers on, use the Sendblue (iMessage) number.
NEXT_PUBLIC_WALLY_NUMBER=
# Text verification (Twilio Verify). Create a Verify service in the Twilio console.
TWILIO_VERIFY_SERVICE_SID=
# Signs the session cookie. At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
# Local testing only: accept this 6-digit code without sending a text. Ignored in Vercel production.
WALLY_DEV_VERIFY_CODE=
# Google sign-in. OAuth client (Web application) from Google Cloud console.
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email sign-in links, sent through Resend. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Optional. Public origin used in emailed links and OAuth redirects, e.g. https://wally-kohl.vercel.app
APP_URL=
# Local testing only: show the sign-in link on screen instead of emailing it. Ignored in Vercel production.
WALLY_DEV_EMAIL_LINKS=
